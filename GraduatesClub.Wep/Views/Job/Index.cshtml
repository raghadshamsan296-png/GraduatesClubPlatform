@model IEnumerable<GraduatesClub.Web.Models.JobViewModel>

@{
    ViewData["Title"] = "الشواغر الوظيفية";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    <h2>قائمة فرص العمل المتاحة</h2>
    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">إضافة فرصة عمل</a>
    </p>
    <div class="row g-2 mb-3 table-filters" data-table-target="jobsTable">
        <div class="col-md-7"><input class="form-control js-table-search" placeholder="ابحث بالمسمى أو المتطلبات" /></div>
        <div class="col-md-3"><select class="form-select js-column-filter" data-column="2"><option value="">كل الشركات</option>@foreach(var name in Model.Select(x => x.CompanyName).Distinct().OrderBy(x => x)){<option>@name</option>}</select></div>
        <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100 js-clear-filters">مسح الفلاتر</button></div>
    </div>
    <table id="jobsTable" class="table table-striped table-bordered mt-2 data-table" data-hide-default-search="true">
        <thead class="table-dark">
            <tr>
                <th>الرقم</th>
                <th>المسمى الوظيفي</th>
                <th>اسم الشركة</th>
                <th>المتطلبات</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.JobTitle</td>
                        <td>@item.CompanyName</td>
                        <td>@item.Requirements</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">تفاصيل</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
