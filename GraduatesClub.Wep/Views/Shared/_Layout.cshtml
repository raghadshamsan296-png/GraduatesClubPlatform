<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نادي الخريجين</title>
    
    <!-- استدعاء Bootstrap 5 للغة العربية (RTL) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <!-- مكتبة الأيقونات Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- خط Cairo العربي الفخم -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f8f9fa;
        }
        /* تخصيص لون الزر النشط (الغامق) في القائمة الجانبية */
        .list-group-item.active {
            background-color: #052c65 !important;
            border-color: #052c65 !important;
        }
        .sidebar-link {
            transition: all 0.3s ease;
        }
        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            
            <!-- القائمة الجانبية (Sidebar) مع التحديد التلقائي للزر النشط -->
            <div class="col-md-3 col-lg-2 bg-primary text-white p-3 min-vh-100 shadow-sm" style="direction: rtl; text-align: right;">
                <h4 class="fw-bold text-center mb-4 pb-2 border-bottom border-light">
                    <i class="bi bi-mortarboard-fill me-2"></i> نادي الخريجين
                </h4>
                
                <div class="list-group list-group-flush gap-1">
                    <!-- زر لوحة التحكم الرئيسية -->
                    <a href="/Dashboard/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active fw-bold shadow-sm" : "")">
                        <i class="bi bi-house-door-fill ms-2"></i> لوحة التحكم الرئيسية
                    </a>

                    <!-- زر دليل الخريجين -->
                    <a href="/Alumni/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alumni" ? "active fw-bold shadow-sm" : "")">
                        <i class="bi bi-people-fill ms-2"></i> دليل الخريجين
                    </a>

                    <a href="/Department/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link">الأقسام</a>
                    <a href="/Event/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link">الفعاليات</a>

                    <!-- زر الشواغر الوظيفية -->
                    <a href="/Job/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Job" ? "active fw-bold shadow-sm" : "")">
                        <i class="bi bi-briefcase-fill ms-2"></i> الشواغر الوظيفية
                    </a>

                    <!-- زر الإعلانات والملتقيات -->
                    <a href="/Announcement/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcement" ? "active fw-bold shadow-sm" : "")">
                        <i class="bi bi-megaphone-fill ms-2"></i> الإعلانات والملتقيات
                    </a>

                    <!-- زر الملف الشخصي -->
                    <a href="/Settings/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active fw-bold shadow-sm" : "")">
                        <i class="bi bi-person-circle ms-2"></i> الملف الشخصي
                    </a>
                    <a href="/Messages/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link">رسائل التواصل</a>
                    <a href="/Users/Index" class="list-group-item list-group-item-action text-white bg-transparent rounded sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active fw-bold shadow-sm" : "")"><i class="bi bi-person-gear ms-2"></i> المستخدمون</a>
                    <button type="button" class="btn btn-outline-light mt-2" data-bs-toggle="modal" data-bs-target="#systemHelpModal"><i class="bi bi-info-circle"></i> عن النظام</button>
                    <form asp-controller="Login" asp-action="Logout" method="post" class="mt-3"><button class="btn btn-outline-light w-100">تسجيل الخروج</button></form>
                </div>
            </div>

            <!-- محتوى الصفحات الديناميكي (Body) -->
            <main class="col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <div class="modal fade" id="systemHelpModal" tabindex="-1" aria-labelledby="systemHelpTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="systemHelpTitle">منصة نادي الخريجين</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body">نظام MVC لإدارة الخريجين والأقسام والفعاليات والوظائف والإعلانات، مع Web API موثّق بواسطة Swagger.</div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">حسنًا</button></div></div></div></div>

    <!-- استدعاء ملفات جافاسكريبت لـ Bootstrap -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
