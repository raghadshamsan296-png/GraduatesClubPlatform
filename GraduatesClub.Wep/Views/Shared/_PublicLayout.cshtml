<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - نادي الخريجين</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"/><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><style>body{font-family:'Cairo',sans-serif}</style></head><body><nav class="navbar navbar-expand-lg navbar-dark" style="background:var(--club-primary-dark)"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="bi bi-mortarboard-fill"></i> نادي الخريجين</a><div class="d-flex gap-2"><a class="btn btn-outline-light" asp-controller="Home" asp-action="Contact">تواصل معنا</a><a class="btn btn-warning" asp-controller="Login" asp-action="Index">دخول الإدارة</a></div></div></nav><main class="container py-4">@RenderBody()</main><footer class="border-top py-3 text-center text-muted">منصة نادي الخريجين - @DateTime.Today.Year</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
