@model GraduatesClub.Web.Controllers.EventViewModel
@{ ViewData["Title"]="تعديل فعالية"; }
<div class="container mt-4"><h2>تعديل الفعالية</h2><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-2"><label asp-for="Title">العنوان</label><input asp-for="Title" class="form-control"/></div><div class="mb-2"><label asp-for="Description">الوصف</label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-2"><label asp-for="EventDate">التاريخ</label><input asp-for="EventDate" type="datetime-local" class="form-control"/></div><div class="mb-3"><label asp-for="AlumniId">الخريج</label><select asp-for="AlumniId" asp-items="ViewBag.AlumniId" class="form-select"></select></div><button class="btn btn-success">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></form></div>
