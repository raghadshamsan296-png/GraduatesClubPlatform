@model IEnumerable<GraduatesClub.Web.Controllers.EventViewModel>

@{
    ViewData["Title"] = "إدارة الفعاليات";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">إدارة الفعاليات</h2>
        <!-- رابط مباشر لضمان استجابة زر الإضافة -->
        <a href="/Event/Create" class="btn btn-primary btn-lg shadow-sm" style="position: relative; z-index: 9999;">➕ إضافة فعالية جديدة</a>
    </div>

    <div class="row g-2 mb-3 table-filters" data-table-target="eventsTable">
        <div class="col-md-7"><input class="form-control js-table-search" placeholder="ابحث بالعنوان أو الوصف أو اسم الخريج" /></div>
        <div class="col-md-3"><select class="form-select js-year-filter" data-column="2"><option value="">كل السنوات</option>@foreach(var year in Model.Select(x => x.EventDate.Year).Distinct().OrderByDescending(x => x)){<option>@year</option>}</select></div>
        <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100 js-clear-filters">مسح الفلاتر</button></div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table id="eventsTable" class="table table-hover align-middle mb-0 data-table" data-hide-default-search="true">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4">عنوان الفعالية</th>
                        <th class="py-3 px-4">الوصف</th>
                        <th class="py-3 px-4">التاريخ</th>
                        <th class="py-3 px-4">الخريج المنظم</th>
                        <th class="py-3 px-4 text-center" style="width: 150px;">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-bold text-primary">@item.Title</td>
                                <td class="py-3 px-4">@item.Description</td>
                                <td class="py-3 px-4">@item.EventDate.ToString("yyyy/MM/dd")</td>
                                <td class="py-3 px-4">@item.AlumniName</td>
                                <td class="py-3 px-4 text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">تفاصيل</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
