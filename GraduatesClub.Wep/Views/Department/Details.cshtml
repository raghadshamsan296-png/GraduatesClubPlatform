@model GraduatesClub.Domain.Entities.Department
@{ ViewData["Title"] = "تفاصيل القسم"; }

<div class="card p-4 shadow-sm col-md-6 mx-auto mt-4">
    <h3>تفاصيل القسم</h3>
    <dl class="row mt-3">
        <dt class="col-sm-4">رقم القسم:</dt>
        <dd class="col-sm-8">@Model.Id</dd>
        <dt class="col-sm-4">اسم القسم:</dt>
        <dd class="col-sm-8">@Model.Name</dd>
    </dl>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
        <a asp-action="Index" class="btn btn-secondary">عودة للقائمة</a>
    </div>
</div>