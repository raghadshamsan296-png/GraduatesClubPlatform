@model GraduatesClub.Domain.Entities.Department
@{ ViewData["Title"] = "حذف قسم"; }

<div class="card p-4 shadow-sm col-md-6 mx-auto mt-4 border-danger">
    <h3 class="text-danger">هل أنت متأكد من حذف هذا القسم؟</h3>
    <dl class="row mt-3">
        <dt class="col-sm-4">اسم القسم:</dt>
        <dd class="col-sm-8">@Model.Name</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">تأكيد الحذف</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>