@model GraduatesClub.Domain.Entities.Department

@{
    ViewData["Title"] = "إضافة قسم جديد";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    <div class="card shadow-sm p-4">
        <h2 class="mb-4 text-primary">إضافة قسم جديد</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label font-weight-bold">اسم القسم</label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم القسم هنا..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success px-4">حفظ القسم</button>
                <a asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}