@model IEnumerable<GraduatesClub.Domain.Entities.Department>

@{
    ViewData["Title"] = "إدارة الأقسام";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center p-3">
            <h4 class="mb-0">قائمة الأقسام</h4>
            <a asp-action="Create" class="btn btn-primary">إضافة قسم جديد</a>
        </div>
        <table class="table table-hover align-middle mb-0 data-table">
            <thead class="table-dark">
                <tr>
                    <th>اسم القسم</th>
                    <th class="py-3 px-4 text-center" style="width: 150px;">العمليات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">تفاصيل</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
