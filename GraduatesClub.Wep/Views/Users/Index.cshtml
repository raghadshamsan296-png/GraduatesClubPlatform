@model IEnumerable<GraduatesClub.Domain.Entities.UserProfile>
@{ ViewData["Title"] = "المستخدمون"; }
@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card shadow-sm border-0"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">المستخدمون</h2><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> إضافة مستخدم</a></div><table class="table table-striped align-middle data-table"><thead><tr><th>الاسم</th><th>البريد</th><th>الهاتف</th><th>العمليات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td>@x.Phone</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-warning">تعديل</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-danger">حذف</a></td></tr>}</tbody></table></div></div>
