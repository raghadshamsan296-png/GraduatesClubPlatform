@model GraduatesClub.Domain.Entities.UserProfile
@{ ViewData["Title"] = "تفاصيل المستخدم"; }
<div class="card shadow-sm border-0"><div class="card-body p-4"><h2>@Model.FullName</h2><dl class="row"><dt class="col-3">البريد</dt><dd class="col-9">@Model.Email</dd><dt class="col-3">الهاتف</dt><dd class="col-9">@Model.Phone</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a> <a asp-action="Index" class="btn btn-secondary">عودة</a></div></div>
