@model GraduatesClub.Web.Models.AnnouncementViewModel
@{ ViewData["Title"] = "تفاصيل الإعلان"; }
<div class="card shadow-sm border-0"><div class="card-body p-4"><h2 class="mb-3">@Model.Title</h2><p class="text-muted"><i class="bi bi-calendar3"></i> @Model.Date.ToString("yyyy/MM/dd")</p><div class="text-pre-wrap mb-4">@Model.Content</div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> تعديل</a> <a asp-action="Index" class="btn btn-secondary">عودة</a></div></div>
