@model IEnumerable<GraduatesClub.Domain.Entities.ContactMessage>
@{ ViewData["Title"] = "رسائل التواصل"; }
<div class="card shadow-sm border-0"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">رسائل التواصل</h2><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة رسالة</a></div><div class="table-responsive"><table class="table table-striped align-middle data-table"><thead><tr><th>الاسم</th><th>البريد</th><th>الرسالة</th><th>التاريخ</th><th>العمليات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td class="text-truncate-cell">@x.Message</td><td>@x.SentAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-warning">تعديل</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-danger">حذف</a></td></tr>}</tbody></table></div></div></div>
