@model GraduatesClub.Domain.Entities.ContactMessage
@{ ViewData["Title"] = "حذف الرسالة"; }
<div class="card border-danger"><div class="card-body p-4"><h2 class="text-danger">تأكيد حذف الرسالة</h2><p>هل تريد حذف رسالة <strong>@Model.FullName</strong>؟</p><p class="text-muted text-pre-wrap">@Model.Message</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden"/><button class="btn btn-danger">نعم، حذف</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></form></div></div>
