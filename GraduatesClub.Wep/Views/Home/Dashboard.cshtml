@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    <h2 class="fw-bold text-primary mb-4">لوحة تحكم نادي الخريجين</h2>
    
    <div class="row g-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">إجمالي الخريجين</h5>
                    <h2 class="fw-bold my-3">1,240</h2>
                    <p class="mb-0 text-white-50">تحديث مستمر</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">فرص العمل المتاحة</h5>
                    <h2 class="fw-bold my-3">45</h2>
                    <p class="mb-0 text-white-50">نشطة حالياً</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">الفعاليات القادمة</h5>
                    <h2 class="fw-bold my-3">8</h2>
                    <p class="mb-0 text-muted">هذا الشهر</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">الإعلانات الجديدة</h5>
                    <h2 class="fw-bold my-3">12</h2>
                    <p class="mb-0 text-white-50">هذا الأسبوع</p>
                </div>
            </div>
        </div>
    </div>
</div>