@model GraduatesClub.Web.Models.ContactViewModel

@{ 
    ViewData["Title"] = "اتصل بنا";
    Layout = "_PublicLayout";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">تواصل مع إدارة نادي الخريجين</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
                    <form asp-action="Contact" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الاسم الكامل</label>
                            <input asp-for="FullName" class="form-control" placeholder="أدخل اسمك..." />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">البريد الإلكتروني</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">نص الرسالة</label>
                            <textarea asp-for="Message" class="form-control" rows="4" placeholder="اكتب استفسارك أو رسالتك هنا..."></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2">إرسال الرسالة</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
