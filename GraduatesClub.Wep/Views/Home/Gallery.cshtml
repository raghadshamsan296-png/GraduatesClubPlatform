@{
    ViewData["Title"] = "معرض الصور";
}

<div class="container mt-4" style="direction: rtl; text-align: right;">
    <h2 class="fw-bold text-primary mb-4">معرض أنشطة وفعاليات النادي</h2>
    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                    <span>صورة حفل التخرج 2025</span>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">حفل تكريم الخريجين السنوي</h5>
                    <p class="text-muted small mb-0">لقطة جماعية للخريجين المتميزين خلال حفل التكريم.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                    <span>صورة ورشة العمل البرمجية</span>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">ورشة تطوير الويب الحديثة</h5>
                    <p class="text-muted small mb-0">جانب من حضور الطلاب والخرجيين لورشة العمل التقنية.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                    <span>صورة الملتقى المهني</span>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">معرض التوظيف السنوي</h5>
                    <p class="text-muted small mb-0">لقاء الخريجين بممثلي الشركات والجهات التوظيفية.</p>
                </div>
            </div>
        </div>
    </div>
</div>