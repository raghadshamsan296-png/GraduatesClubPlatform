@model GraduatesClub.Web.Controllers.PublicHomeViewModel
@{ ViewData["Title"] = "الرئيسية"; Layout = "_PublicLayout"; }
<section class="hero-club p-5 mb-4"><h1 class="fw-bold">مرحبًا بكم في نادي الخريجين</h1><p class="lead mb-0">بوابتكم للتواصل، والفعاليات، والفرص الوظيفية، وآخر أخبار الخريجين.</p></section>
<div class="row g-3 mb-4"><div class="col-md-6"><div class="card stat-card"><div class="card-body text-center"><i class="bi bi-people-fill fs-1 text-primary"></i><h2>@Model.AlumniCount</h2><p class="mb-0">خريج مسجل</p></div></div></div><div class="col-md-6"><div class="card stat-card"><div class="card-body text-center"><i class="bi bi-diagram-3-fill fs-1 text-success"></i><h2>@Model.DepartmentCount</h2><p class="mb-0">قسم أكاديمي</p></div></div></div></div>
<div class="row g-4"><div class="col-lg-4"><h3><i class="bi bi-calendar-event text-primary"></i> الفعاليات القادمة</h3>@foreach(var x in Model.UpcomingEvents){<div class="card mb-2"><div class="card-body"><h5>@x.Title</h5><small>@x.EventDate.ToString("yyyy/MM/dd")</small></div></div>}@if(!Model.UpcomingEvents.Any()){<p class="text-muted">لا توجد فعاليات قادمة.</p>}</div><div class="col-lg-4"><h3><i class="bi bi-briefcase text-primary"></i> أحدث الوظائف</h3>@foreach(var x in Model.LatestJobs){<div class="card mb-2"><div class="card-body"><h5>@x.JobTitle</h5><p class="mb-0">@x.CompanyName</p></div></div>}@if(!Model.LatestJobs.Any()){<p class="text-muted">لا توجد وظائف حاليًا.</p>}</div><div class="col-lg-4"><h3><i class="bi bi-megaphone text-primary"></i> الإعلانات</h3>@foreach(var x in Model.LatestAnnouncements){<div class="card mb-2"><div class="card-body"><h5>@x.Title</h5><p class="mb-0 text-truncate">@x.Content</p></div></div>}@if(!Model.LatestAnnouncements.Any()){<p class="text-muted">لا توجد إعلانات حاليًا.</p>}</div></div>
