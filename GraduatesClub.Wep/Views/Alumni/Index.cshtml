@model IEnumerable<GraduatesClub.Domain.Entities.Alumni>

@{
    ViewData["Title"] = "قائمة الخريجين";
}

<div class="container mt-4">
    <h2>قائمة الخريجين المسجلين</h2>
    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">إضافة خريج جديد</a>
    </p>
    <div class="row g-2 mb-3 table-filters" data-table-target="alumniTable">
        <div class="col-md-5"><input class="form-control js-table-search" placeholder="ابحث بالاسم أو البريد أو الهاتف" /></div>
        <div class="col-md-3"><select class="form-select js-column-filter" data-column="5"><option value="">كل الأقسام</option>@foreach(var name in Model.Where(x => x.Department != null).Select(x => x.Department!.Name).Distinct().OrderBy(x => x)){<option>@name</option>}</select></div>
        <div class="col-md-2"><select class="form-select js-column-filter" data-column="4"><option value="">كل السنوات</option>@foreach(var year in Model.Select(x => x.GraduationYear).Distinct().OrderByDescending(x => x)){<option>@year</option>}</select></div>
        <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100 js-clear-filters">مسح الفلاتر</button></div>
    </div>
    <table id="alumniTable" class="table table-striped table-bordered mt-2 data-table" data-hide-default-search="true">
        <thead class="table-dark">
            <tr>
                <th>الصورة</th>
                <th>الاسم الكامل</th>
                <th>البريد الإلكتروني</th>
                <th>رقم الهاتف</th>
                <th>سنة التخرج</th>
                <th>القسم</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@if(!string.IsNullOrWhiteSpace(item.PhotoPath)){<img src="@item.PhotoPath" alt="صورة @item.FullName" class="alumni-photo"/>}else{<span class="avatar-placeholder"><i class="bi bi-person"></i></span>}</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.GraduationYear</td>
                    <td>@(item.Department != null ? item.Department.Name : "بدون قسم")</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">تفاصيل</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
